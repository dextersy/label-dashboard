# Deployment Configuration Template
# Copy this file to deploy.config and update with your production server details

# SFTP Configuration
SFTP_KEY_PATH="/path/to/your/ssh-key.pem"
PRODUCTION_HOST="your-production-server.com"
SFTP_USER="ubuntu"

# Server Paths
BACKEND_DEPLOY_PATH="/var/www/label-dashboard-api"
FRONTEND_DEPLOY_PATH="/var/www/label-dashboard-web"
SPINDLY_DEPLOY_PATH="/var/www/spindly-landing"
TICKETING_APP_DEPLOY_PATH="/var/www/ticketing-app"

# Build Configuration
API_BUILD_COMMAND="npm run build"
WEB_BUILD_COMMAND="npm run build -- --configuration production"
SPINDLY_BUILD_COMMAND="npm run build"
TICKETING_BUILD_COMMAND="npm run build"

# Ticketing App Configuration
# Domain where public show listings are served (used by the organizer portal to generate links)
TICKETING_APP_PUBLIC_LISTING_DOMAIN="your-listing-domain.com"
# API base URL used in the ticketing app .htaccess for social media crawler SEO redirects
# Must match the apiUrl in environment.prod.ts (without trailing slash)
TICKETING_API_URL="https://your-api-server.com:3001/api"

# PM2 Configuration
PM2_APP_NAME="app"

# API Keys Configuration (Optional)
# If not set here, the script will check environment variables
# GOOGLE_MAPS_API_KEY_CONFIG="your-google-maps-api-key-here"

# Deployment Notifications (Optional)
# If set, deploy scripts will send an email on completion (success or failure).
# DEPLOY_NOTIFY_EMAIL="you@example.com"
#
# SMTP method (recommended — works on Git Bash / Windows and Linux):
# Uses curl to send directly via SMTP. Set all four vars below to enable.
# DEPLOY_SMTP_HOST="smtp.gmail.com"
# DEPLOY_SMTP_PORT="587"           # 587 = STARTTLS (most providers), 465 = SSL
# DEPLOY_SMTP_USER="you@gmail.com"
# DEPLOY_SMTP_PASS="your-app-password"
# DEPLOY_SMTP_FROM="you@gmail.com" # Optional — defaults to DEPLOY_SMTP_USER
#
# Fallback method (Linux only): if SMTP vars are not set, the scripts will try
# the system `mail` command instead.