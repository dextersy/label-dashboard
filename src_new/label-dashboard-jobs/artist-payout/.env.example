# System API Configuration
# Use the System API endpoint and system user credentials
API_BASE_URL=https://api.example.com
API_USERNAME=system@example.com
API_PASSWORD=your-system-user-password

# Email Configuration
SUPERADMIN_EMAIL=superadmin@example.com
FROM_EMAIL=noreply@example.com

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Dry Run Mode
# Set to true to simulate payouts without making real transfers.
# Emails will still be sent with a [DRY RUN] prefix in the subject.
DRY_RUN=false

# Notes:
# - API_USERNAME must be a system user email (is_system_user=true, brand_id=NULL)
# - The job uses /api/system/auth/login for authentication
# - The job triggers payouts across all brands using POST /api/system/process-artist-payouts
# - Per-brand emails are only sent to brands with send_artist_balance_reminders=true
